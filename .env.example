# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens.
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_SECRET"

# PAYMENT GATEWAYS: Server-side secret keys for live payment processing.
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-replace-with-your-flutterwave-secret-key"
